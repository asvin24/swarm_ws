<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="payload_world">
    
    <!-- Physics properties -->
    <physics name="default_physics" type="ode">
      <gravity>0 0 -9.8</gravity>
    </physics>

    <!-- Ground plane as a green field -->
    <model name="green_field">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 200</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.2 1.0 0.2 1</ambient>
            <diffuse>0.2 1.0 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Payload Marker -->
    <model name="payload_marker">
      <static>true</static>
      <pose>-20 70 0.01 0 0 0</pose> <!-- Random position within bounds -->
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>4 4 0.01</size> <!-- 4x4 meter payload marker -->
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>4 4 0.01</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://~/Arty-Part2/worlds/payload_marker.jpg</uri>
              <name>payload_marker_material</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Red Circle Markers -->
    <!-- Red Circle Marker 1 -->
    <model name="red_circle_marker_1">
      <static>true</static>
      <pose>-50 30 0.01 0 0 0</pose> <!-- Random position -->
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 1.2 0.01</size> <!-- 1.2x1.2 meter red circle marker -->
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 1.2 0.01</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://~/Arty-Part2/worlds/red_circle_marker.png</uri>
              <name>red_circle_marker_material</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Red Circle Marker 2 -->
    <model name="red_circle_marker_2">
      <static>true</static>
      <pose>40 -90 0.01 0 0 0</pose> <!-- Random position -->
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 1.2 0.01</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 1.2 0.01</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://~/Arty-Part2/worlds/red_circle_marker.png</uri>
              <name>red_circle_marker_material</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Red Circle Marker 3 -->
    <model name="red_circle_marker_3">
      <static>true</static>
      <pose>-80 -40 0.01 0 0 0</pose> <!-- Random position -->
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 1.2 0.01</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 1.2 0.01</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://~/Arty-Part2/worlds/red_circle_marker.png</uri>
              <name>red_circle_marker_material</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Red Circle Marker 4 -->
    <model name="red_circle_marker_4">
      <static>true</static>
      <pose>20 120 0.01 0 0 0</pose> <!-- Random position -->
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 1.2 0.01</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 1.2 0.01</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://~/Arty-Part2/worlds/red_circle_marker.png</uri>
              <name>red_circle_marker_material</name>
            </script>
          </material>
