      </link>
    </model>

    <!-- Red Circle Marker 5 -->
    <model name="red_circle_marker_5">
      <static>true</static>
      <pose>70 -10 0.01 0 0 0</pose> <!-- Random position -->
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 1.2 0.01</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 1.2 0.01</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://~/Arty-Part2/worlds/red_circle_marker.png</uri>
              <name>red_circle_marker_material</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
