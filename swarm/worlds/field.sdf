<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="payload_world">
    
    <!-- Physics properties -->
    <physics name="default_physics" type="ode">
      <gravity>0 0 -9.8</gravity>
    </physics>


    <!-- Ground plane as a green field -->
    <model name="green_field">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 200</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.2 1.0 0.2 1</ambient>
            <diffuse>0.2 1.0 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
